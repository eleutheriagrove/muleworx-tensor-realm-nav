{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://x.ai/ars/q-rational/report/v0.1",
  "title": "TrajectoryReport",
  "description": "Q-Rational three-class residual trajectory diagnostic (CLOSED | DENSE | MULTI | AMBIGUOUS). Pathfinder only.",
  "type": "object",
  "required": ["class_label", "unique_states", "cycle", "critical_modes_alive", "critical_visibility"],
  "properties": {
    "class_label": {
      "type": "string",
      "enum": ["CLOSED", "DENSE", "MULTI", "AMBIGUOUS"]
    },
    "unique_states": { "type": "integer", "minimum": 0 },
    "cycle": { "type": "boolean" },
    "cycle_length": { "type": ["integer", "null"], "minimum": 1 },
    "critical_modes_alive": { "type": "integer", "minimum": 0 },
    "critical_visibility": {
      "type": "number",
      "minimum": 0,
      "description": "Σ mass·residual over critical modes (same as ARS exit_score)"
    },
    "entropy": { "type": "number", "minimum": 0 },
    "total_hops": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string" },
    "config": {
      "type": "object",
      "description": "Free parameters used for this classification (mass_bins, residual_bins, thresholds, etc.)"
    }
  }
}
