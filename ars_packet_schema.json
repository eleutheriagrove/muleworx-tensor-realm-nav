{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://x.ai/ars/packet/v0.1",
  "title": "ARSPacket",
  "description": "Frozen ARS residual packet schema (v0.1). Critical-visibility exit metric only. Anti-crush (k_min ≥ 2). Lady Aetheris constraints observed.",
  "type": "object",
  "required": ["residual_vector", "exit_score", "k_min", "condition"],
  "properties": {
    "residual_vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mass", "residual", "critical"],
        "properties": {
          "mass": { "type": "number", "minimum": 0 },
          "residual": { "type": "number", "minimum": 0 },
          "critical": { "type": "boolean" },
          "claim": { "type": "string" },
          "meta": { "type": "object" }
        }
      }
    },
    "hop_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hop_id", "kind"],
        "properties": {
          "hop_id": { "type": "integer", "minimum": 0 },
          "kind": {
            "type": "string",
            "enum": ["crush", "anti-crush", "inject", "prune", "exit"]
          },
          "note": { "type": "string" },
          "delta_mass": { "type": ["number", "null"] },
          "delta_residual": { "type": ["number", "null"] },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "inject": {
      "type": ["object", "null"],
      "description": "First-class inject hop (optional)."
    },
    "exit_score": {
      "type": "number",
      "minimum": 0,
      "description": "Critical visibility = Σ m_i * r_i over critical modes only."
    },
    "k_min": {
      "type": "integer",
      "minimum": 2,
      "default": 2,
      "description": "Anti-crush floor. Packet is invalid if live modes < k_min."
    },
    "condition": {
      "type": "string",
      "enum": ["pure", "mixed", "instructed-stubborn"]
    },
    "integrity_note": {
      "type": "string",
      "description": "Mandatory integrity bound. Must state surface type and any missing pressure terms."
    }
  }
}
